    "content": "<!-- wp:mbn-theme/home {\"heroHeading\":\"Advanced motorcycle suspension, <span>tuning, service & rebuilds.</span>\",\"heroBackgroundType\":\"video\",\"heroBackgroundVideoId\":174,\"heroBackgroundVideoUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/hero-banner-video.mp4\",\"heroBackgroundImageId\":35,\"heroBackgroundImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/hero-background-scaled.jpg\",\"whyChooseHeading\":\"Why Choose <span>DA - Motorsports</span>\",\"whyChooseItems\":[{\"title\":\"Factory-Level Race Suspension\",\"text\":\"Factory race suspension for every rider at every level. Built through years of R&D and real-world track testing, TBT Racing delivers proven settings trusted by everyone from AMA Supercross racers to local C-class riders.\",\"iconImageId\":24,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-factory-suspension.png\"},{\"title\":\"Backed by TBT RACING\",\"text\":\"All our off-road settings are developed at TBT Racing HQ and refined by real test riders of all skill levels. Each setup goes through weeks or months of rigorous testing to ensure proven performance and complete customer satisfaction.\",\"iconImageId\":22,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-tbt-racing.png\"},{\"title\":\"Harley Davidson Suspension\",\"text\":\"Our Harley Davidson suspension packages deliver a smoother, more stable, and safer ride. Whether you're touring the country or pushing your bike on the track, we have the ideal setup for your riding style.\",\"iconImageId\":23,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-harley-suspension.png\"},{\"title\":\"98% Satisfaction Rating\",\"text\":\"We're proud of our products and service. And with good reason. DA Motorsports boasts a 98% satisfaction rating on the first setup of every motorcycle. But we don't stop there. If your setup isn't perfect, we'll fine-tune the suspension at no charge until it is. Our promise is simple: 100% satisfaction…in writing.\",\"iconImageId\":25,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-satisfaction-rating.png\"}],\"servicesBackgroundType\":\"image\",\"servicesBackgroundVideoId\":175,\"servicesBackgroundVideoUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/bg-effect-overlay.mp4\",\"servicesBackgroundImageId\":85,\"servicesBackgroundImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/services-page-bg.jpg\",\"servicesHeaderImageId\":48,\"servicesHeaderImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/motor-suspension-services-header.png\",\"servicesHeading\":\"Motorcycle <span>Suspension <br/>Services</span> That Deliver\",\"serviceItems\":[{\"title\":\"Suspension Tuning\",\"text\":\"Our custom tuning services are developed for each individual rider based on their weight, ability and the terrain they ride on.\",\"iconImageId\":0,\"iconImageUrl\":\"\"},{\"title\":\"Revalving & Internal Work\",\"text\":\"Our revalving service fine- tunes the internal valve stack and components to deliver optimal suspension performance for specific terrain and conditions. Each setup is developed through extensive R&D and real-world testing.\",\"iconImageId\":0,\"iconImageUrl\":\"\"},{\"title\":\"Suspension Service\",\"text\":\"Routine maintenance is essential to keep your suspension performing at its best. We offer complete chassis and suspension care, including lubrication, oil changes and seal replacement services - all to ensure optimal performance.\",\"iconImageId\":37,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-suspesion-service.svg\"},{\"title\":\"Setup & Adjustments\",\"text\":\"Proper suspension setup is the foundation of every great motorcycle. We set SAG and adjust external settings to create a precise performance baseline. Essential for off-road and street bikes, to ensure your suspension works the way it should.\",\"iconImageId\":41,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-setup-adjustments.svg\"},{\"title\":\"Rebuilds\",\"text\":\"Rebuilds go beyond basic maintenance. All critical components and wear items are replaced… restoring the system to like-new condition.\",\"iconImageId\":39,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-rebuilds.svg\"},{\"title\":\"Advanced Suspension Support\",\"text\":\"We provide trackside suspension tuning and support for racers. This service is available to anyone who wants to take their settings to the next level.\",\"iconImageId\":38,\"iconImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/icon-adv-suspension-support.svg\"}],\"cta1Heading\":\"Let <span>DA-Motorsports</span><br/> dial-in your Suspension\",\"cta1BackgroundImageId\":43,\"cta1BackgroundImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/cta-background-1.jpg\",\"testimonials\":[{\"quote\":\"The TBT RACING team in Chandler AZ worked with me to get my 2025 KTM 350XCF suspension setup specifically for my weight, riding style and the terrain I ride on. The difference was incredible. My bike is now stable, balanced and I feel more confident at speeds. I highly recommend TBT RACING to anyone looking for custom suspension tuning.\"\",\"authorName\":\"Marcus Reid\",\"authorTitle\":\"Motocross racer, Arizona\",\"authorImageId\":27,\"authorImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/avatar-marcus-reid.png\",\"rating\":5}],\"locations\":[{\"title\":\"Chandler\",\"subtitle\":\"TBT Racing HQ, Chandler Arizona\",\"buttonText\":\"get directions\",\"buttonUrl\":\"#\",\"mapImageId\":44,\"mapImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/location-map-chandler.jpg\",\"isActive\":true},{\"title\":\"scottsdale\",\"subtitle\":\"TBT Racing HQ, Scottsdale Arizona\",\"buttonText\":\"get directions\",\"buttonUrl\":\"#\",\"mapImageId\":77,\"mapImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/location-map-scottsdale.jpg\",\"isActive\":false},{\"title\":\"phoenix\",\"subtitle\":\"TBT Racing HQ, Scottsdale Arizona\",\"buttonText\":\"get directions\",\"buttonUrl\":\"#\",\"mapImageId\":76,\"mapImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/location-map-phoenix.jpg\",\"isActive\":false}],\"faqBackgroundImageId\":50,\"faqBackgroundImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/faq-background.jpg\",\"faqSubheading\":\"\",\"cta2Heading\":\"Arizona's most dependable dirt bike & <br/>motorcycle suspension shop is here. For you.\",\"cta2BackgroundImageId\":45,\"cta2BackgroundImageUrl\":\"https://mysite.dev.local/wp-content/uploads/2026/06/cta-final-background.jpg\"} /-->"
}