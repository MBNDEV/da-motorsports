{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mbn-theme/site-footer",
  "title": "Site Footer",
  "description": "Complete site footer with logo, newsletter signup, link columns, and copyright information.",
  "category": "mbn-blocks",
  "keywords": ["footer", "links", "newsletter", "copyright", "social"],
  "textdomain": "mbn-theme",
  "version": "1.0.0",
  "supports": {
    "anchor": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "logoImageId": {
      "type": "number",
      "default": 0
    },
    "logoImageUrl": {
      "type": "string",
      "default": ""
    },
    "newsletterText": {
      "type": "string",
      "default": "Want to stay up-to-date on suspension tuning tips and new services?"
    },
    "gravityFormShortcode": {
      "type": "string",
      "default": "[gravityform id=\"1\" title=\"true\"]"
    },
    "disclaimerText": {
      "type": "string",
      "default": "You agree to our Privacy Policy and consent to receive updates from DA-Motorsports."
    },
    "servicesLinks": {
      "type": "array",
      "default": [
        {
          "label": "Suspension Tuning",
          "url": "#"
        },
        {
          "label": "Suspension Service",
          "url": "#"
        },
        {
          "label": "Rebuilds",
          "url": "#"
        },
        {
          "label": "Revalving & Internal Work",
          "url": "#"
        },
        {
          "label": "Setup & Adjustments",
          "url": "#"
        },
        {
          "label": "Advanced Suspension Support",
          "url": "#"
        }
      ]
    },
    "companyLinks": {
      "type": "array",
      "default": [
        {
          "label": "Home",
          "url": "#"
        },
        {
          "label": "About",
          "url": "#"
        },
        {
          "label": "Contact info",
          "url": "#"
        }
      ]
    },
    "socialLinks": {
      "type": "array",
      "default": [
        {
          "label": "Facebook",
          "url": "#",
          "icon": "facebook"
        },
        {
          "label": "Facebook",
          "url": "#",
          "icon": "facebook"
        },
        {
          "label": "Instagram",
          "url": "#",
          "icon": "instagram"
        },
        {
          "label": "X",
          "url": "#",
          "icon": "x"
        },
        {
          "label": "LinkedIn",
          "url": "#",
          "icon": "linkedin"
        },
        {
          "label": "YouTube",
          "url": "#",
          "icon": "youtube"
        }
      ]
    },
    "copyrightText": {
      "type": "string",
      "default": "© 2026 DA-Motorsports. All rights reserved."
    },
    "legalLinks": {
      "type": "array",
      "default": [
        {
          "label": "Privacy Policy",
          "url": "#"
        },
        {
          "label": "Terms of Service",
          "url": "#"
        },
        {
          "label": "Cookie Settings",
          "url": "#"
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
